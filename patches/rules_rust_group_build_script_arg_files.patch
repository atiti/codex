+// Bazel spills wrapper flags on Windows. Child rustc @files retain their existing handling.
+fn expand_wrapper_param_files(
+    argv: Vec<String>,
+    mut read_file: impl FnMut(&str) -> Result<String, OptionError>,
+) -> Result<Vec<String>, OptionError> {
+    let mut expanded = Vec::new();
+    let mut before_separator = true;
+    for (index, arg) in argv.into_iter().enumerate() {
+        if index != 0 && before_separator && arg.starts_with('@') {
+            // Multiline Args encode each complete argument without shell escaping.
+            for value in read_file(&arg[1..])?.lines() {
+                if value == "--" {
+                    before_separator = false;
+                }
+                expanded.push(value.to_owned());
+            }
+        } else {
+            if index != 0 && arg == "--" {
+                before_separator = false;
+            }
+            expanded.push(arg);
+        }
+    }
+    Ok(expanded)
 }
 
